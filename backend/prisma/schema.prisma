  brouillon
  validee

  @@map("statut_ecriture")
}

model EcritureComptable {
  id               String            @id @default(uuid()) @db.Uuid
  numero           String            @unique @db.VarChar(40)
  journalId        String            @map("journal_id") @db.Uuid
  exerciceId       String            @map("exercice_id") @db.Uuid
  date             DateTime
  libelle          String            @db.VarChar(255)
  piece            String?           @db.VarChar(100)
  dossierId        String?           @map("dossier_id") @db.Uuid
  statut           StatutEcriture    @default(brouillon)
  sourceType       String?           @map("source_type") @db.VarChar(50)
  sourceId         String?           @map("source_id") @db.VarChar(64)
  contrepasseeDeId String?           @map("contrepassee_de_id") @db.Uuid
  createdById      String            @map("created_by_id") @db.Uuid
  valideeParId     String?           @map("validee_par_id") @db.Uuid
  valideeAt        DateTime?         @map("validee_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  journal          JournalComptable  @relation(fields: [journalId], references: [id])
  exercice         ExerciceComptable @relation(fields: [exerciceId], references: [id])
  dossier          Dossier?          @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("EcritureCreateur", fields: [createdById], references: [id])
  valideePar       User?             @relation("EcritureValideur", fields: [valideeParId], references: [id])
  lignes           LigneEcriture[]

  @@unique([sourceType, sourceId])
  @@index([date])
  @@map("ecritures_comptables")
}

model LigneEcriture {
  id         String            @id @default(uuid()) @db.Uuid
  ecritureId String            @map("ecriture_id") @db.Uuid
  compteId   String            @map("compte_id") @db.Uuid
  libelle    String?           @db.VarChar(255)
  debit      Decimal           @default(0) @db.Decimal(15, 2)
  credit     Decimal           @default(0) @db.Decimal(15, 2)
  tiers      String?           @db.VarChar(255)
  ordre      Int               @default(0)
  ecriture   EcritureComptable @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  compte     CompteComptable   @relation(fields: [compteId], references: [id])

  @@index([compteId])
  @@map("lignes_ecriture")
}


